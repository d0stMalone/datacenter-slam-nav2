<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_robot</name>
  <version>0.1.0</version>
  <description>
    Custom differential-drive robot for Gazebo Classic: URDF/Xacro model, warehouse world,
    and launch/config files for simulation, SLAM (slam_toolbox) and navigation (Nav2).
  </description>
  <maintainer email="visariakeval@gmail.com">Keval Visaria</maintainer>
  <license>MIT</license>

  <!-- Simulation -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>

  <!-- Robot description -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- SLAM / maps / teleop -->
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_theta_star_planner</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <!-- Visualization -->
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
    <!-- Lets Gazebo resolve package://my_robot/... URIs -->
    <gazebo_ros gazebo_model_path="${prefix}/.."/>
  </export>
</package>
