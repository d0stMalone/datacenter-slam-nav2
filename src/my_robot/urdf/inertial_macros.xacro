<?xml version="1.0"?>
<!--
  Inertia tensors for primitive shapes (solid, uniform density), about the shape's centre.
  Gazebo's physics engine needs realistic mass/inertia: values that are too small or zero
  make the robot jitter, sink, or fly away.

  Formulas: https://en.wikipedia.org/wiki/List_of_moments_of_inertia
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Box with side lengths x, y, z -->
  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass / 12.0 * (y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${mass / 12.0 * (x*x + z*z)}" iyz="0.0"
               izz="${mass / 12.0 * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- Cylinder of radius r and length h, axis along local z -->
  <xacro:macro name="inertial_cylinder" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass / 12.0 * (3*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
               iyy="${mass / 12.0 * (3*radius*radius + length*length)}" iyz="0.0"
               izz="${mass / 2.0 * radius*radius}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid sphere of radius r -->
  <xacro:macro name="inertial_sphere" params="mass radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${2.0 / 5.0 * mass * radius*radius}" ixy="0.0" ixz="0.0"
               iyy="${2.0 / 5.0 * mass * radius*radius}" iyz="0.0"
               izz="${2.0 / 5.0 * mass * radius*radius}"/>
    </inertial>
  </xacro:macro>

</robot>
