<?xml version="1.0"?>
<!--
  Sensors: 2D lidar and RGB-D (depth) camera. Each has a URDF link (for TF / RViz) and a Gazebo
  <sensor> block whose ROS plugin publishes the data.
  Uses properties defined in dc_robot.urdf.xacro.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== 2D Lidar ===================== -->
  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_height" value="0.04"/>
  <!--
    The lidar sits on a 5 cm standoff. With the scan plane only ~2 cm above the chassis,
    Gazebo's (CPU) ray sensor intermittently hit the robot's own body: ~6 phantom points per
    scan at 0.12-0.17 m, which Nav2 would treat as obstacles touching the robot.
  -->
  <xacro:property name="lidar_mount_height" value="0.05"/>

  <link name="laser">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      <material name="black"/>
    </visual>
    <!-- Standoff post: visual only (a collision here could be hit by the rays too). -->
    <visual>
      <origin xyz="0 0 ${-(lidar_height + lidar_mount_height)/2}"/>
      <geometry><cylinder radius="0.012" length="${lidar_mount_height}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.15" radius="${lidar_radius}" length="${lidar_height}">
      <origin xyz="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <!-- Above the axle, on the standoff: scan plane ~0.22 m above the floor. -->
    <origin xyz="0 0 ${chassis_height + lidar_mount_height + lidar_height/2}"/>
  </joint>

  <gazebo reference="laser">
    <material>Gazebo/Black</material>
    <sensor name="lidar" type="ray">  <!-- CPU ray: works without a GPU (VMs, CI) -->
      <always_on>true</always_on>
      <visualize>false</visualize>  <!-- set true to see the blue rays in Gazebo -->
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <!-- 0.25 deg (like a Hokuyo UST-10LX). At 1 deg the beams are 7 cm apart at 4 m, so a
                 cart's 3 cm legs were hit in some scans and missed in others (worst while turning):
                 the costmap, and with it the plan, flipped between "aisle blocked" and "free". -->
            <samples>1440</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>                    <!-- > lidar radius, so it never sees itself -->
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>              <!-- 1 cm noise, like a cheap real lidar -->
        </noise>
      </ray>
      <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>  <!-- publish on /scan -->
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===================== Camera ===================== -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.06 0.03"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.06 0.03"/></geometry>
    </collision>
    <xacro:inertial_box mass="0.05" x="0.02" y="0.06" z="0.03">
      <origin xyz="0 0 0"/>
    </xacro:inertial_box>
  </link>
  <!--
    Mounted on a short mast at the front, 0.32 m above the floor, tilted 20 deg down (like a
    RealSense on a TurtleBot 4 / warehouse AMR). It was first on the chassis front at 0.12 m:
    from there a cart's bottom shelf (0.19 m) is seen almost edge-on, only a few pixel rows
    hit it, and the costmap got a thin line instead of the whole shelf. From above, the shelf's
    top surface fills many pixels, and the tilt also shrinks the blind zone in front of the robot.
  -->
  <xacro:property name="camera_z" value="0.27"/>      <!-- above base_link (axle, 0.05 m) -->
  <xacro:property name="camera_tilt" value="0.35"/>   <!-- rad, ~20 deg down -->
  <xacro:property name="camera_x" value="${chassis_offset_x + chassis_length/2 + 0.01}"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} 0 ${camera_z}" rpy="0 ${camera_tilt} 0"/>
  </joint>

  <!-- Mast: visual only. It crosses the lidar's scan plane; a collision would be hit by the rays. -->
  <link name="camera_mast">
    <visual>
      <geometry><cylinder radius="0.008" length="${camera_z - chassis_height - 0.015}"/></geometry>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="camera_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mast"/>
    <origin xyz="${camera_x - 0.01} 0 ${(camera_z + chassis_height - 0.015) / 2}"/>
  </joint>

  <!--
    ROS has two camera frame conventions:
      camera_link          : x forward, y left, z up (like every other robot frame)
      camera_optical_link  : z forward, x right, y down (what image-processing code expects)
    The image is stamped with the optical frame.
  -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!--
    RGB-D camera (like an Intel RealSense D435). The 2D lidar only sees a thin slice 0.22 m
    above the floor, so it misses things like the bottom shelf of a cart (0.19-0.22 m) and
    treats the 0.44 m gap between the cart's legs as free. The depth camera fills that gap:
    its point cloud goes into the costmaps' 3D voxel layer (config/nav2_params.yaml).
    Topics: /camera/image_raw (colour), /camera/depth/image_raw, /camera/points.
  -->
  <gazebo reference="camera_link">
    <material>Gazebo/Blue</material>
    <sensor name="camera" type="depth">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <camera>
        <horizontal_fov>1.518</horizontal_fov>   <!-- 87 deg, as a D435 depth module -->
        <image>
          <width>160</width>                      <!-- low res: plenty for a 5 cm costmap, cheap to render -->
          <height>120</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>8.0</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <frame_name>camera_optical_link</frame_name>
        <min_depth>0.1</min_depth>
        <max_depth>8.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

</robot>
