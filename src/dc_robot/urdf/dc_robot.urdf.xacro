<?xml version="1.0"?>
<!--
  dc_robot (data-centre robot): a compact differential-drive base.

  Frame layout (REP-105 style):
    base_link       : midpoint between the drive wheels, at axle height. This is the robot's
                      centre of rotation, which keeps Nav2's motion model simple.
    base_footprint  : base_link projected onto the ground (z = 0).
    chassis         : the body (carries the mass), behind the axle so the rear caster carries load.
    laser           : 2D lidar on top.
    camera_link     : forward-facing camera (+ camera_optical_link in the optical convention).

  Footprint ~ 0.34 m (x) x 0.35 m (y); Nav2 uses these numbers in Phase 4.
-->
<robot name="dc_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="inertial_macros.xacro"/>

  <!-- ===================== Dimensions (metres, kg) ===================== -->
  <xacro:property name="chassis_length" value="0.34"/>
  <xacro:property name="chassis_width"  value="0.26"/>
  <xacro:property name="chassis_height" value="0.10"/>
  <xacro:property name="chassis_offset_x" value="-0.06"/>  <!-- chassis centre behind the axle -->
  <xacro:property name="chassis_mass"   value="3.0"/>

  <xacro:property name="wheel_radius"     value="0.05"/>
  <xacro:property name="wheel_width"      value="0.04"/>
  <xacro:property name="wheel_separation" value="0.31"/>  <!-- centre-to-centre -->
  <xacro:property name="wheel_mass"       value="0.3"/>

  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_x"      value="-0.18"/>
  <xacro:property name="caster_mass"   value="0.1"/>

  <!-- ===================== Materials (RViz colours) ===================== -->
  <material name="orange"><color rgba="1.0 0.45 0.05 1.0"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="blue"><color rgba="0.1 0.3 0.9 1.0"/></material>

  <!-- ===================== Base frames ===================== -->
  <!-- base_link has no inertia: KDL (used by robot_state_publisher) rejects a root link with mass. -->
  <link name="base_link"/>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 ${-wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Chassis ===================== -->
  <!-- Bottom face sits at axle height, so the body clears the ground by wheel_radius. -->
  <link name="chassis">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
      <origin xyz="0 0 ${chassis_height/2}"/>
    </xacro:inertial_box>
  </link>
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="${chassis_offset_x} 0 0"/>
  </joint>

  <!-- ===================== Drive wheels ===================== -->
  <!--
    The cylinder axis is the link's z-axis, so each wheel joint is rotated +-90 deg about x to
    point it sideways. The right wheel's axis is flipped so that a positive velocity on BOTH
    joints drives the robot forward (what the diff_drive plugin expects).
  -->
  <xacro:macro name="drive_wheel" params="side y_sign roll axis_sign">
    <link name="${side}_wheel">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <!--
        Collision is a SPHERE, not a cylinder. With a cylinder, ODE creates several contact
        points across the tread that fight each other: measured against Gazebo ground truth,
        the robot turned ~8% less than its wheels reported (≈7° heading error per 90° turn),
        so odometry drifted by metres. A sphere gives one contact point exactly under the
        wheel centre: error dropped to <0.1°. (The visual stays a cylinder.)
      -->
      <collision>
        <geometry><sphere radius="${wheel_radius}"/></geometry>
      </collision>
      <xacro:inertial_cylinder mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}">
        <origin xyz="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <origin xyz="0 ${y_sign * wheel_separation/2} 0" rpy="${roll} 0 0"/>
      <axis xyz="0 0 ${axis_sign}"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel side="left"  y_sign="1"  roll="${-pi/2}" axis_sign="1"/>
  <xacro:drive_wheel side="right" y_sign="-1" roll="${pi/2}"  axis_sign="-1"/>

  <!-- ===================== Rear caster ===================== -->
  <!-- A frictionless sphere (see gazebo.xacro). Simpler and more stable in sim than a swivel caster. -->
  <link name="caster_wheel">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}">
      <origin xyz="0 0 0"/>
    </xacro:inertial_sphere>
  </link>
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <!-- Centre is caster_radius above the ground, i.e. (wheel_radius - caster_radius) below base_link. -->
    <origin xyz="${caster_x} 0 ${caster_radius - wheel_radius}"/>
  </joint>

  <!-- ===================== Sensors & simulation ===================== -->
  <xacro:include filename="sensors.xacro"/>
  <xacro:include filename="gazebo.xacro"/>

</robot>
