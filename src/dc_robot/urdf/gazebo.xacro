<?xml version="1.0"?>
<!--
  Gazebo-only settings: surface friction, colours, and the plugins that connect the simulated
  robot to ROS. Uses properties defined in dc_robot.urdf.xacro.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Surfaces & colours ===================== -->
  <gazebo reference="chassis">
    <material>Gazebo/Orange</material>
  </gazebo>

  <!-- Drive wheels: high friction so they grip; kp/kd make the contact stiff (no sinking). -->
  <xacro:macro name="wheel_surface" params="link">
    <gazebo reference="${link}">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_surface link="left_wheel"/>
  <xacro:wheel_surface link="right_wheel"/>

  <!-- Caster: (almost) frictionless so it slides in any direction. -->
  <gazebo reference="caster_wheel">
    <material>Gazebo/Grey</material>
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <!-- ===================== Differential drive ===================== -->
  <!--
    Subscribes to /cmd_vel (geometry_msgs/Twist), turns linear.x / angular.z into wheel
    velocities, and integrates the wheel rotation into odometry:
      publishes /odom (nav_msgs/Odometry) and the TF  odom -> base_link
  -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>50</update_rate>

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>

      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>

      <!-- 0 = ENCODER: odometry from integrated wheel motion, so it drifts like a real robot
           (SLAM/AMCL have something to correct). 1 = WORLD would be perfect ground truth. -->
      <odometry_source>0</odometry_source>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>  <!-- robot_state_publisher does this -->
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ===================== Ground truth ===================== -->
  <!--
    Gazebo's exact pose of base_link in the world, on /ground_truth/odom. NOT used by any
    robot software (a real robot has no such thing); it exists so we can measure how accurate
    odometry, SLAM and AMCL really are.
  -->
  <gazebo>
    <plugin name="ground_truth" filename="libgazebo_ros_p3d.so">
      <ros>
        <remapping>odom:=ground_truth/odom</remapping>
      </ros>
      <body_name>base_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

  <!-- ===================== Joint states ===================== -->
  <!-- Publishes wheel angles on /joint_states so robot_state_publisher can broadcast wheel TFs. -->
  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>30</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
