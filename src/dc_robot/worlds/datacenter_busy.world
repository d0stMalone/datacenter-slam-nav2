<?xml version="1.0"?>
<!--
  datacenter_busy.world: the data centre + people, ladders and carts in the aisles (each its own model).
  As datacenter.world: a whole data-centre building, 162.5 m x 38 m,
  modelled on a real floor plan (dimensions estimated from standard 600 x 1200 mm racks).
    west annex (benches) | west corridor | hall W: 12 pods | core: plant rooms + corridor |
    hall E1: 6 pods | hall E2: 6 pods. Each hall: CRAH galleries north and south behind a
    fan wall, a north and a south bank of pods (2 rows of 14 racks around a hot
    aisle), and a cross aisle between the banks. 13 electrical rooms along the north side.
  Robot spawn point (see sim.launch.py): (-4.95, -2.75), facing east (+x).
  GENERATED by scripts/generate_worlds.py; edit the layout there, not this file.
-->
<sdf version="1.6">
  <world name="datacenter_busy">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <shadows>false</shadows>
      <ambient>0.6 0.6 0.6 1</ambient>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -75 110 0 1.05 1.5708</pose>
      </camera>
    </gui>

    <model name="datacenter_layout">
      <static>true</static>
