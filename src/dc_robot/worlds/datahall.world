<?xml version="1.0"?>
<!--
  datahall.world: 20 m x 14 m data-centre hall for SLAM / navigation testing.
  Four rows of 42U racks in a hot/cold-aisle layout (1.2 m aisles), split by a cross aisle;
  CRAC units, UPS cabinets, PDUs, columns, a NOC office and a fenced storage cage.
  Robot spawn point (see sim.launch.py): (-6.0, -5.2).
  GENERATED by scripts/generate_worlds.py; edit the layout there, not this file.
-->
<sdf version="1.6">
  <world name="datahall">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <shadows>false</shadows>
      <ambient>0.6 0.6 0.6 1</ambient>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -17 19 0 0.85 1.5708</pose>
      </camera>
    </gui>

