<?xml version="1.0"?>
<!--
  warehouse.world: 14 m x 10 m indoor layout for SLAM / navigation testing.
    x in [-7, 2]  : warehouse floor with three shelving rows, pillars and crates
    x in [ 2, 7]  : two small offices, reached through doorways in the partition wall
  Robot spawn point (see sim.launch.py): (-5.8, 0.0).
  GENERATED by scripts/generate_worlds.py; edit the layout there, not this file.
-->
<sdf version="1.6">
  <world name="warehouse">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <shadows>false</shadows>
      <ambient>0.6 0.6 0.6 1</ambient>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -9 12 0 0.9 1.5708</pose>
      </camera>
    </gui>

